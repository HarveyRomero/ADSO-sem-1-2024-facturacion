
CREATE DATABASE CompaFact;
USE CompaFact;
CREATE TABLE Cliente (
    ID_Cliente       INT AUTO_INCREMENT PRIMARY KEY,
    nombre           VARCHAR(255) NOT NULL,
    telefono         INT NOT NULL,
    direccion        VARCHAR(255) NOT NULL,
    email            VARCHAR(255) NOT NULL,
    documento_tipo   ENUM(
                       'Tarjeta de identidad',
                       'Cédula de ciudadanía',
                       'Cédula de extranjería',
                       'Pasaporte'
                     ) NOT NULL,
    documento_numero INT NOT NULL UNIQUE,
    fecha_nacimiento DATE NOT NULL,
    ciudad VARCHAR(100) NOT NULL
);

-- Tabla para Usuario
CREATE TABLE Usuario (
  ID_Usuario INT AUTO_INCREMENT PRIMARY KEY,  
  nombre VARCHAR(255) NOT NULL,  
  telefono INT NOT NULL,  
  direccion VARCHAR(255) NOT NULL,  
  email VARCHAR(255) NOT NULL,  
  contraseña VARCHAR(255) NOT NULL,  
  rol ENUM('Administrador', 'Vendedor', 'Bodega') NOT NULL,  
  fecha_alta DATE NOT NULL,  -- Fecha de alta del usuario
  documento_tipo ENUM('Cedula de ciudadania', 'Cedula de extranjeria', 'Pasaporte') NOT NULL,  
  documento_numero INT NOT NULL UNIQUE,  
  fecha_nacimiento DATE NOT NULL  
);

-- Tabla para Producto
CREATE TABLE Producto (
  ID_Producto INT AUTO_INCREMENT PRIMARY KEY,  
  Nombre_de_producto VARCHAR(255) NOT NULL, 
  Descripcion_de_producto TEXT NOT NULL,  
  codigo_producto INT NOT NULL UNIQUE,  
  categoria ENUM('Computadoras y Accesorios', 'Celulares y Accesorios', 'Televisores y Audio', 
                 'Electrodomésticos pequeños', 'Videojuegos y Consolas', 'Redes y Conectividad', 
                 'Componentes y Repuestos', 'Cámaras y Fotografía', 'Baterías y Cargadores', 
                 'Otros accesorios') NOT NULL,  -- Categoría del producto
  stock ENUM('En camino', 'Con Stock', 'Sin Stock') NOT NULL, 
  precio DECIMAL(10, 2) NOT NULL,  
  CONSTRAINT UC_codigo_producto UNIQUE (codigo_producto)  
);


-- Tabla para Factura
CREATE TABLE Factura (
  ID_factura INT AUTO_INCREMENT PRIMARY KEY,  
  fecha DATE NOT NULL,  
  hora TIME NOT NULL,  
  valor DECIMAL(10, 2) NOT NULL,  
  ID_Cliente INT,  
  ID_Usuario INT,  
  FOREIGN KEY (ID_Cliente) REFERENCES Cliente(ID_Cliente),  
  FOREIGN KEY (ID_Usuario) REFERENCES Usuario(ID_Usuario)  
);

-- Tabla para DetalleFactura
CREATE TABLE DetalleFactura (
  ID_Detalle INT AUTO_INCREMENT PRIMARY KEY,  
  ID_Factura INT,  
  ID_Producto INT,  
  cantidad INT NOT NULL,  
  subtotal DECIMAL(10, 2) NOT NULL,  
  FOREIGN KEY (ID_Factura) REFERENCES Factura(ID_factura),  
  FOREIGN KEY (ID_Producto) REFERENCES Producto(ID_Producto)  
);

-- Tabla para TipoPago
CREATE TABLE TipoPago (
  ID_Pago INT AUTO_INCREMENT PRIMARY KEY,  
  monto DECIMAL(10, 2) NOT NULL,  
  metodoPago ENUM('Efectivo', 'Tarjeta de crédito', 'Tarjeta de débito', 'Transferencia bancaria') NOT NULL,  
  fecha DATE NOT NULL,  
  ID_Factura INT,  
  FOREIGN KEY (ID_Factura) REFERENCES Factura(ID_factura)  
);


